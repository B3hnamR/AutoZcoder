# normalize line endings for a clean cross-platform repo
* text=auto

*.py   text eol=lf
*.js   text eol=lf
*.ts   text eol=lf
*.css  text eol=lf
*.json text eol=lf
*.html text eol=lf
*.md   text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.toml text eol=lf
*.txt  text eol=lf
*.ini  text eol=lf

*.ps1  text eol=crlf
*.bat  text eol=crlf

*.ico  binary
*.png  binary

*.sh   text eol=lf

# bundled exit-network clients and their server list are binaries
vendor/psiphon/psiphon-tunnel-core-* binary
vendor/psiphon/server-list.dat binary
vendor/surfshark/wireproxy-* binary
