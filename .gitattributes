# normalize line endings for a clean cross-platform repo
* text=auto

*.py   text eol=lf
*.js   text eol=lf
*.html text eol=lf
*.md   text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.toml text eol=lf
*.txt  text eol=lf
*.ini  text eol=lf

*.ps1  text eol=crlf
*.bat  text eol=crlf

*.ico  binary
*.png  binary
